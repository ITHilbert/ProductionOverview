<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ProductionOverview</AssemblyName>
    <RootNamespace>ProductionOverview</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameManaged>C:\Program Files (x86)\Steam\steamapps\common\Captain of Industry\Captain of Industry_Data\Managed</GameManaged>
    <ModInstallDir>$(APPDATA)\Captain of Industry\Mods\ProductionOverview</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Mafi"><HintPath>$(GameManaged)\Mafi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mafi.Core"><HintPath>$(GameManaged)\Mafi.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mafi.Unity"><HintPath>$(GameManaged)\Mafi.Unity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(GameManaged)\UnityEngine.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(GameManaged)\netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="InstallMod" AfterTargets="Build">
    <MakeDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="$(TargetPath);manifest.json;thumbnail.png;LICENSE;changelog.txt" DestinationFolder="$(ModInstallDir)" />
  </Target>
</Project>
